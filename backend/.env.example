# Kopiraj ovaj fajl u .env i upisi svoje vrednosti. .env se NE commit-uje.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartpark
DB_USER=smartpark
DB_PASSWORD=promeni_me

# Generisi sa: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Dozvoljeni origin-i za frontend (zarezom odvojeni, * je dozvoljen za port)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
